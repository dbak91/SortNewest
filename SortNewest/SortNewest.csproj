<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0-android36.0</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>SortNewest</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<ApplicationTitle>SortNewest</ApplicationTitle>
	<ApplicationId>com.companyname.SortNewest</ApplicationId>
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>
	<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	<AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
	<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#121212" />
  </ItemGroup>
	<Import Project="release-signing\SortNewest.signing.props"
		  Condition="'$(Configuration)' == 'Release' And Exists('release-signing\SortNewest.signing.props')" />
</Project>
